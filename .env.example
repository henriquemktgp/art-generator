# Chave de API do Magnific (geração de imagem por IA — modelo Mystic)
# Obtenha em: https://www.magnific.com (Settings > API Keys)
MAGNIFIC_API_KEY=

# Porta do servidor (opcional — padrão: 3000)
# PORT=3000
